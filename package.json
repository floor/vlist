{
  "name": "vlist",
  "version": "3.1.0",
  "description": "Lightweight, high-performance virtual list with zero dependencies",
  "author": {
    "name": "Floor IO",
    "url": "https://floor.io"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/floor/vlist.git"
  },
  "keywords": [
    "virtual-list",
    "virtual-scroll",
    "virtualized-list",
    "infinite-scroll",
    "windowing",
    "list-virtualization",
    "dom-recycling",
    "large-list",
    "performance",
    "typescript",
    "zero-dependencies"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./synthetic": {
      "types": "./dist/synthetic.d.ts",
      "import": "./dist/synthetic.js",
      "default": "./dist/synthetic.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "default": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "default": "./dist/svelte.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js",
      "default": "./dist/solid.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./internals": {
      "types": "./dist/internals.d.ts",
      "import": "./dist/internals.js",
      "default": "./dist/internals.js"
    },
    "./styles": "./dist/vlist.css",
    "./styles/grid": "./dist/vlist-grid.css",
    "./styles/masonry": "./dist/vlist-masonry.css",
    "./styles/table": "./dist/vlist-table.css",
    "./styles/extras": "./dist/vlist-extras.css",
    "./styles/tree": "./dist/vlist-tree.css",
    "./styles/search": "./dist/vlist-search.css",
    "./styles/carousel": "./dist/vlist-carousel.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.css",
    "dist/size.json",
    "dist/version.json",
    "!dist/**/*.d.ts.map"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun run build.ts --watch",
    "test": "bun test",
    "test:changed": "bun test --changed",
    "test:browser": "bun scripts/rtl-cross-axis-browser.mjs && bun scripts/synthetic-browser.mjs && bun scripts/synthetic-carousel-browser.mjs && bun scripts/synthetic-sortable-browser.mjs && bun scripts/select-next-browser.mjs && bun scripts/item-fill-browser.mjs && bun scripts/scroll-mode-browser.mjs && bun scripts/native-cap-browser.mjs && bun scripts/tree-guides-browser.mjs && bun scripts/table-header-browser.mjs && bun scripts/focus-removal-browser.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.types.json && tsc --noEmit -p tsconfig.test.json",
    "bench": "bun run scripts/bench.ts",
    "bench:quick": "bun run scripts/bench.ts --quick",
    "bench:full": "bun run scripts/bench.ts --full",
    "bench:compare": "bun run scripts/bench.ts --quick --compare",
    "size": "bun run scripts/size.ts",
    "heap": "bun run scripts/heap.ts",
    "docs:check": "bun run scripts/docs-check.ts",
    "release": "bun run scripts/release.ts",
    "prepublishOnly": "bun run build -- --types && cp README.md README.github.md && cp npm-readme.md README.md",
    "postpublish": "cp README.github.md README.md && rm README.github.md"
  },
  "bugs": {
    "url": "https://github.com/floor/vlist/issues"
  },
  "homepage": "https://vlist.io",
  "peerDependencies": {
    "react": ">=17.0.0",
    "vue": ">=3.0.0",
    "svelte": ">=4.0.0",
    "solid-js": ">=1.6.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@types/bun": "^1.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "jsdom": "^28.0.0",
    "puppeteer-core": "^24.43.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "solid-js": "^1.9.3",
    "svelte": "^5.0.0",
    "typescript": "^5.0.0",
    "vue": "^3.5.28"
  }
}
